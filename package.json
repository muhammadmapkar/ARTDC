{
  "name": "repairlens",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --offline --android",
    "ios": "expo start --offline --ios",
    "web": "expo start --offline --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web --output-dir dist --max-workers 1",
    "check:expo": "EXPO_OFFLINE=1 expo install --check"
  },
