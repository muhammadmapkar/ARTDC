    "expo-clipboard": "~8.0.8",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-modules-core": "~3.0.29",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.30.0",
